# Second Look configuration. Copy to .env (never commit .env).
# These names are app-owned conventions; the provider adapter maps them to the SDK.

# offline | foundry | foundry_local
#   foundry:       Microsoft Foundry cloud project. Needs the two FOUNDRY_ values below and an Entra
#                  sign-in: locally `az login`; in a deployment AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_CLIENT_SECRET.
#   foundry_local: Foundry Local on this machine, no Azure subscription. Install with
#                  `winget install Microsoft.FoundryLocal`, then `foundry server start` and
#                  `foundry model load <FOUNDRY_LOCAL_MODEL>` before starting the backend.
SECOND_LOOK_MODE=offline

# Microsoft Foundry project endpoint and model deployment name (no API keys are used).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=

# Foundry Local model alias (must support tool calling, e.g. qwen3-8b). The server URL is found
# automatically via `foundry server status`; set FOUNDRY_LOCAL_ENDPOINT only to override it.
FOUNDRY_LOCAL_MODEL=
FOUNDRY_LOCAL_ENDPOINT=

# Azure AI Speech (optional, P1)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Limits
SIMULATION_MAX_ROLLOUTS=200
INVESTIGATION_TIMEOUT_SECONDS=60
